import java.util.Scanner;
public class TabuadaWhile {
	
	public static void main(String[] args) {
		Scanner s = new Scanner(System.in);
		int n, i = 1, r;
		System.out.print("Informe um número inteiro: ");
		n = s.nextInt();
		while (i <= 10) {
			r = n * i;
			System.out.println( n, " x ", i, " = ", r);
			i++;
		}	
		s.close();	
	}
}
